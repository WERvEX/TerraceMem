# ==============================================================================
# TerraceMem Environment Configuration
# ==============================================================================

# --- Database (PostgreSQL + pgvector 0.8 + ParadeDB pg_search) ---
# Storage backend: "auto" (PG if reachable, else in-memory fallback), "postgres", or "memory"
TERRACEMEM_STORAGE_BACKEND=auto
TERRACEMEM_DATABASE_URL=postgresql://terracemem:terracemem@localhost:5432/terracemem
# Lexical backend: "paradedb" (default, true BM25 + Jieba + Fast Fields) or "native" (tsvector fallback)
TERRACEMEM_LEXICAL_BACKEND=paradedb
TERRACEMEM_EMBEDDING_DIM=1024
TERRACEMEM_ENABLE_BACKGROUND_WORKER=false

# --- LLM / Embedding / Reranker (OpenAI-Compatible API-First) ---
TERRACEMEM_LLM_API_KEY=your-api-key-here
TERRACEMEM_LLM_BASE_URL=https://api.openai.com/v1
TERRACEMEM_LLM_MODEL=gpt-4o-mini
TERRACEMEM_FAST_LLM_MODEL=gpt-4o-mini

TERRACEMEM_EMBEDDING_API_KEY=your-api-key-here
TERRACEMEM_EMBEDDING_BASE_URL=https://api.openai.com/v1
TERRACEMEM_EMBEDDING_MODEL=text-embedding-3-small

# Optional external Reranker (Jina / SiliconFlow / DashScope / local TEI)
TERRACEMEM_RERANKER_ENABLED=false
TERRACEMEM_RERANKER_API_KEY=
TERRACEMEM_RERANKER_BASE_URL=
TERRACEMEM_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Feature Flags ---
# Optional write-time LLM summarization & keyword enrichment for outline navigation & BM25 boost
TERRACEMEM_ENABLE_WRITE_TIME_ENRICHMENT=false
# Enable 2-hop lightweight entity relation CTE expansion in RAG retrieval
TERRACEMEM_ENABLE_GRAPH_EXPANSION=true
# Strict citation entailment verification on generated answers
TERRACEMEM_STRICT_CITATION_MODE=true
# Embedded lightweight developer Inspector UI mounted at /ui
TERRACEMEM_ENABLE_INSPECTOR_UI=true

# --- Agentic RAG Execution Budgets ---
TERRACEMEM_MAX_RETRIEVAL_RETRIES=2
TERRACEMEM_MAX_STATE_TRANSITIONS=10
TERRACEMEM_MAX_LLM_CALLS=5
TERRACEMEM_REQUEST_TIMEOUT_SECONDS=30

# --- Server ---
TERRACEMEM_HOST=0.0.0.0
TERRACEMEM_PORT=8000
TERRACEMEM_LOG_LEVEL=INFO
